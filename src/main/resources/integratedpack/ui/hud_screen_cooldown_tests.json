{
  "geyser_data_control": {
    "type": "panel",
    "size": [0, 0],
    "property_bag": {
      "#preserved_data": ""
    },
    "bindings": [
      {
        "binding_name": "#tip_text",
        "binding_condition": "always"
      },
      {
        "binding_name": "#tip_text",
        "binding_name_override": "#preserved_data",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#tip_text = #preserved_data) and not ((#tip_text - $update_string) = #tip_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // Geyser added elements
  "geyser_crosshair_cooldown": {
    "type": "panel",
    "size": [16, 16],
    "offset": [0, 12],
    "anchor_from": "center",
    "anchor_to": "center",

    "controls": [{"image": {
      "type": "image",
      "texture": "textures/geyser/ui/crosshair_attack_indicator_progress",
      "size": [16, 8],
      "alpha": 0.5,
      "layer": 2,
      "clip_pixelperfect": true,
      "clip_direction": "left",
      "controls": [
        {"geyser_crosshair_data_control@hud.geyser_data_control": {
          "$update_string": "geyseropt:crosshair_cooldown:"
        }},
        {
          "empty_texture": {
            "type": "image",
            "texture": "textures/geyser/ui/crosshair_attack_indicator_background",
            "alpha": 0.5,
            "layer": -1
          }
        }
      ]
    }}],
    "bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_control_name": "geyser_crosshair_data_control",
        "source_property_name": "(#preserved_data - 'geyseropt:crosshair_cooldown:')",
        "target_property_name": "#value"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#value = 'hide'))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "((16.0 - (((#value == 'hide') ? 1.0 : (#value * 1)) * 16)) / 16.0)",
        "target_property_name": "#clip_ratio"
      }
    ]
  },
  "geyser_hotbar_cooldown": {
    "type": "panel",
    "size": [16, 16],
    "offset": [4, 0],
    "anchor_from": "center",
    "anchor_to": "center",

    "controls": [{"image": {
      "type": "image",
      "texture": "textures/geyser/ui/hotbar_attack_indicator_progress",
      "size": [16, 8],
      "alpha": 0.5,
      "layer": 2,
      "clip_pixelperfect": true,
      "clip_direction": "down",
      "controls": [
        {"geyser_hotbar_data_control@hud.geyser_data_control": {
          "$update_string": "geyseropt:hotbar_cooldown:"
        }},
        {
          "empty_texture": {
            "type": "image",
            "texture": "textures/geyser/ui/hotbar_attack_indicator_background",
            "alpha": 0.5,
            "layer": -1
          }
        }
      ]
    }}],
    "bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_control_name": "geyser_hotbar_data_control",
        "source_property_name": "(#preserved_data - 'geyseropt:hotbar_cooldown:')",
        "target_property_name": "#value"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#value = 'hide'))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "((16.0 - (((#value == 'hide') ? 1.0 : (#value * 1)) * 16)) / 16.0)",
        "target_property_name": "#clip_ratio"
      }
    ]
  },

  // Element modification
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "geyser_crosshair_cooldown@hud.geyser_crosshair_cooldown": {} },
          { "debug_value": {
            "type": "label",
            "text": "#text",
            "anchor_from": "center",
            "anchor_to": "center",
            "bindings": [
              {
                "binding_name": "#tip_text",
                "binding_name_override": "#text",
                "binding_condition": "always"
              }
            ]
          } }
        ]
      }
    ]
  },
  "hotbar_end_cap": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "geyser_hotbar_cooldown@hud.geyser_hotbar_cooldown": {} }
        ]
      }
    ]
  },
  "root_panel/hud_tip_text_factory": {
    "ignored": true
  }
}